# AI-Tender environment variables
# The application does not automatically load this file. Export the values in
# your shell, or use the CLI --database option.

# Optional SQLite SQLAlchemy URL. Takes precedence over TENDER_DB_PATH.
# TENDER_DATABASE_URL=sqlite:///./runtime/tender.db

# Optional SQLite file path. Relative paths are resolved from the current
# working directory. CLI --database takes precedence over this variable.
# TENDER_DB_PATH=./runtime/tender.db

# Maximum seconds to wait for another local process to release the SQLite
# write queue. Default: 1800.
TENDER_DB_LOCK_TIMEOUT_SECONDS=1800

# Optional SearXNG endpoint. The searxng provider is disabled in
# config/search_providers.yaml by default; setting this value alone does not
# enable it.
# SEARXNG_URL=http://127.0.0.1:8080
